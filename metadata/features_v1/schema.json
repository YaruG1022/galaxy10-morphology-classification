    {
      "name": "proxy_concentration",
      "group": "morphology_proxy",
      "definition": "5 log10(r80/r20), using nonnegative segmented display light; undefined if r20 <= 0.5 pixels",
      "units": "dimensionless"
    },
    {
      "name": "proxy_asymmetry",
      "group": "morphology_proxy",
      "definition": "Sum |segmented light - 180-degree rotated light| / total segmented light; fixed moment center, no background correction",
      "units": "dimensionless"
    },
    {
      "name": "proxy_smoothness",
      "group": "morphology_proxy",
      "definition": "10 times positive light-minus-Gaussian(sigma=3) residual outside a 2-pixel core, divided by total light; no background correction",
      "units": "dimensionless"
    },
    {
      "name": "proxy_gini",
      "group": "morphology_proxy",
      "definition": "Finite-sample Gini coefficient over nonnegative segmented pixel values, including zeros",
      "units": "dimensionless"
    },
    {
      "name": "proxy_m20",
      "group": "morphology_proxy",
      "definition": "log10 of moment in brightest >=20% cumulative-light pixels / total moment about light centroid",
      "units": "dimensionless"
    },
    {
      "name": "proxy_r20",
      "group": "morphology_proxy",
      "definition": "Interpolated radius enclosing 20% of segmented display light",
      "units": "pixels on 128x128 image"
    },
    {
      "name": "proxy_r50",
      "group": "morphology_proxy",
      "definition": "Interpolated radius enclosing 50% of segmented display light",
      "units": "pixels on 128x128 image"
    },
    {
      "name": "proxy_r80",
      "group": "morphology_proxy",
      "definition": "Interpolated radius enclosing 80% of segmented display light",
      "units": "pixels on 128x128 image"
    },
    {
      "name": "proxy_axis_ratio",
      "group": "morphology_proxy",
      "definition": "sqrt(minor/major eigenvalue of light-weighted central second moments)",
      "units": "dimensionless"
    },
    {
      "name": "proxy_elongation",
      "group": "morphology_proxy",
      "definition": "Inverse axis ratio; undefined for zero minor eigenvalue",
      "units": "dimensionless"
    },
    {
      "name": "proxy_eccentricity",
      "group": "morphology_proxy",
      "definition": "sqrt(1-axis_ratio^2)",
      "units": "dimensionless"
    },
    {
      "name": "object_area_fraction",
      "group": "morphology_proxy",
      "definition": "Number of target-mask pixels / 128^2",
      "units": "dimensionless"
    },
    {
      "name": "centroid_offset_fraction",
      "group": "morphology_proxy",
      "definition": "Moment-centroid distance from geometric center / 128",
      "units": "dimensionless"
    },
    {
      "name": "central_light_fraction",
      "group": "morphology_proxy",
      "definition": "Segmented light within 16 pixels of the target centroid / total segmented light",
      "units": "dimensionless"
    },
    {
      "name": "mean_segmented_signal",
      "group": "morphology_proxy",
      "definition": "Mean background-subtracted nonnegative light over the selected mask",
      "units": "dimensionless"
    },
    {
      "name": "flag_fallback_mask",
      "group": "quality_flag",
      "definition": "No qualifying central component; use fixed central circular aperture",
      "units": "0 or 1"
    },
    {
      "name": "flag_no_signal",
      "group": "quality_flag",
      "definition": "Zero total segmented background-subtracted display light",
      "units": "0 or 1"
    },
    {
      "name": "flag_degenerate_moments",
      "group": "quality_flag",
      "definition": "Shape moments or minor eigenvalue are degenerate",
      "units": "0 or 1"
    },
    {
      "name": "flag_undefined_concentration",
      "group": "quality_flag",
      "definition": "Concentration undefined at current pixel resolution",
      "units": "0 or 1"
    },
    {
      "name": "flag_undefined_m20",
      "group": "quality_flag",
      "definition": "Brightest-pixel or total second moment is zero",
      "units": "0 or 1"
    },
    {
      "name": "flag_mask_at_boundary",
      "group": "quality_flag",
      "definition": "Selected component reaches the fixed 48-pixel detection boundary",
      "units": "0 or 1"
    }
  ],
